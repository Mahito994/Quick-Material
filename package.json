{
  "name": "quick-material",
  "version": "1.1.2",
  "description": "Eine material variante von Quick-CMD",
  "author": "mahito994",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.mahito994.quickmaterial",
    "productName": "Quick Material",
    "directories": {
      "output": "dist"
    },
    "extraResources": [
      "speedtest.exe"
    ],
    "win": {
      "target": "nsis",
      "icon": "logo/favicon.ico"
    },
    "forceCodeSigning": false
  }
}